# Rust build output (also holds the release exe and the MSI bundle)
/target/
**/*.rs.bk

# Node / frontend
node_modules/
app/dist/
app/.svelte-kit/
app/test-results/
app/playwright-report/
app/blob-report/
*.local
*.log
npm-debug.log*

# Tauri
app/src-tauri/target/
app/src-tauri/gen/

# App data, databases, secrets
.env
.env.*
*.db
*.db-wal
*.db-shm
/data/
!crates/legacy/tests/fixtures/*.db

# Python (parity tools)
__pycache__/
*.pyc
.venv/

# Claude Code: shared skills are tracked, personal and runtime files are not
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
